# Database credentials (WAMP MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=animated_db

# NextAuth Configuration
# Generate a secure secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Email Delivery (SMTP / Gmail / Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
EMAIL_FROM=PayChase <your_email@gmail.com>
# Or using Resend:
# RESEND_API_KEY=re_your_api_key_here

# Automated Reminders / Cron Security
CRON_SECRET=your_random_secret_for_cron_endpoints

# Admin Notification Email
ADMIN_EMAIL=nk1103200478@gmail.com

# Razorpay Payment Gateway Credentials
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
